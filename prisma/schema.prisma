generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  STANDARD
  CONFIGURABLE
}

enum PartType {
  FRAME
  DOOR
  SHELF
  DRAWER
  ACCESSORY
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  image     String?
  sortOrder Int        @default(0)
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
}

model Product {
  id          Int             @id @default(autoincrement())
  name        String
  slug        String          @unique
  sku         String          @unique
  description String?         @db.Text
  type        ProductType     @default(STANDARD)
  basePrice   Decimal         @db.Decimal(10, 2)
  salePrice   Decimal?        @db.Decimal(10, 2)
  stock       Int             @default(0)
  isActive    Boolean         @default(true)
  attributes  Json?
  categoryId  Int
  category    Category        @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  favorites   Favorite[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  sku       String  @unique
  name      String
  color     String?
  width     Int?
  height    Int?
  depth     Int?
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Part {
  id       Int      @id @default(autoincrement())
  name     String
  type     PartType
  width    Int
  height   Int
  depth    Int
  price    Decimal  @db.Decimal(10, 2)
  color    String?
  modelUrl String?
  rules    Json?
  isActive Boolean  @default(true)
}

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  passwordHash  String
  name          String?
  phone         String?
  orders        Order[]
  savedDesigns  SavedDesign[]
  addresses     Address[]
  favorites     Favorite[]
  createdAt     DateTime      @default(now())
}

model Order {
  id        Int         @id @default(autoincrement())
  code      String      @unique @default(uuid())
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(10, 2)
  fullName  String
  email     String
  phone     String
  address   Json
  note      String?     @db.Text
  userId    Int?
  user      User?       @relation(fields: [userId], references: [id])
  items     OrderItem[]
  cargoCompany String?
  trackingCode String?
  shippedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([userId])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  config      Json?
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model SavedDesign {
  id        Int      @id @default(autoincrement())
  name      String
  data      Json
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  title     String
  fullName  String
  phone     String
  il        String
  ilce      String
  adres     String   @db.Text
  isDefault Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model SiteSetting {
  key   String @id
  value String @db.Text
}